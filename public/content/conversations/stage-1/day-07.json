  "narrations": [
    {
      "id": "s1-d7-n1",
      "textKo": "약속을 잡고, 예약하고, 메뉴를 주문하고, 길을 묻고, 안부를 나누며 한 주가 빠르게 지나갔다.",
      "textEn": "You set up a dinner, booked a table, ordered food, asked for directions, and caught up with a friend. Quite a week."
    },
    {
      "id": "s1-d7-n2",
      "textKo": "집에 가기 전, 채나가 약속을 자연스럽게 마무리하는 표현 몇 가지를 꺼낸다.",
      "textEn": "Before you head home, Channa brings up a few ways to end plans naturally."
    }
  ],
  "dialogue": [
    {
      "id": "s1-d7-d1",
      "speakerId": "learner",
      "speakerLabelKo": "나",
      "textKo": "이번 주 정말 빨리 지나갔다.",
      "textEn": "This week went by fast."
    },
    {
      "id": "s1-d7-d2",
      "speakerId": "channa",
      "speakerLabelKo": "챈나",
      "textKo": "그러게. 작은 약속들도 꽤 자연스럽게 잘했어.",
      "textEn": "It did. And you handled a lot of little plans naturally."
    },
    {
      "id": "s1-d7-d3",
      "speakerId": "learner",
      "speakerLabelKo": "나",
      "textKo": "조만간 또 만나자.",
      "textEn": "Let's catch up again soon.",
      "responseQuiz": {
        "type": "next-line-choice",
        "promptKo": "친구에게 조만간 다시 만나자고 자연스럽게 말하려고 합니다. 가장 알맞은 답을 고르세요.",
        "promptEn": "You want to suggest meeting again soon. Choose the best reply.",
        "options": [
          {
            "id": "a",
            "text": "Let's catch up again soon."
          },
          {
            "id": "b",
            "text": "Forget you ever met me."
          },
          {
            "id": "c",
            "text": "End this conversation now."
          },
          {
            "id": "d",
            "text": "Goodbye and never call."
          }
        ],
        "correctOptionId": "a",
        "explanationKo": "`Let's catch up again soon.`은 친구에게 조만간 다시 보자고 가볍게 말할 때 자연스럽습니다."
      }
